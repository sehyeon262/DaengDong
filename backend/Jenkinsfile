pipeline {
    agent any

    tools {
        jdk 'jdk17'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // 브랜치 인식 상태를 확인하기 위한 디버그 스테이지
        stage('Debug Branch') {
            steps {
                script {
                    echo "Current BRANCH_NAME: ${env.BRANCH_NAME}"
                    echo "Current GIT_BRANCH: ${env.GIT_BRANCH}"
                }
            }
        }

        stage('Spring Boot Build') {
            steps {
                dir('backend') {
                    sh 'chmod +x ./gradlew'
                    sh './gradlew clean build -x test'
                }
            }
        }

        stage('Docker Image Build') {
            steps {
                dir('backend') {
                    script {
                        def isMain = (env.BRANCH_NAME == 'main' || env.GIT_BRANCH == 'origin/main' || env.GIT_BRANCH == 'main')
                        if (isMain) {
                            sh 'docker build -t backend-app-prod .'
                        } else {
                            sh 'docker build -t backend-app-dev .'
                        }
                    }
                }
            }
        }

        // [개발 환경 배포] Secret File과 글로벌 변수를 사용합니다.
        stage('Deploy to Dev') {
            when {
                anyOf {
                    branch 'develop'
                    expression { env.GIT_BRANCH == 'origin/develop' }
                    expression { env.GIT_BRANCH == 'develop' }
                    expression { env.BRANCH_NAME == 'develop' }
                }
            }
            steps {
                // 젠킨스에 등록한 Secret File을 임시 경로($TEMP_ENV)에 할당합니다.
                withCredentials([file(credentialsId: 'be-dev-env', variable: 'TEMP_ENV')]) {
                    script {
                        // 실제 서버 경로는 환경 변수(${DEV_ENV_PATH})로 처리하여 코드에서 숨깁니다.
                        sh "docker compose -f ./docker-compose-dev.yaml --env-file ${TEMP_ENV} up -d --build app"
                    }
                }
            }
        }

        // [운영 환경 배포]
        stage('Deploy to Prod') {
            when {
                anyOf {
                    branch 'main'
                    expression { env.GIT_BRANCH == 'origin/main' }
                    expression { env.GIT_BRANCH == 'main' }
                    expression { env.BRANCH_NAME == 'main' }
                }
            }
            steps {
                withCredentials([file(credentialsId: 'be-prod-env', variable: 'TEMP_ENV')]) {
                    script {
                        // 운영 서버 경로 역시 변수화하여 노출을 차단합니다.
                        sh "docker compose -f ./docker-compose-prod.yaml --env-file ${TEMP_ENV} up -d --build app"
                    }
                }
            }
        }
    }
    
    post {
        always {
            sh 'docker image prune -f'
        }
    }
}