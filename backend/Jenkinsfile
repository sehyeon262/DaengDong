pipeline {
    agent any

    tools {
        jdk 'jdk17'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Spring Boot Build') {
            steps {
                dir('backend') {
                    sh 'chmod +x ./gradlew'
                    sh './gradlew clean build -x test'
                }
            }
        }

        stage('Docker Image Build') {
            steps {
                dir('backend') {
                    script {
                        // 브랜치에 따라 이미지 태그를 다르게 설정하여 관리합니다.
                        if (env.BRANCH_NAME == 'main') {
                            sh 'docker build -t backend-app-prod .'
                        } else {
                            sh 'docker build -t backend-app-dev .'
                        }
                    }
                }
            }
        }

        // [개발 환경] develop 브랜치일 때만 실행됩니다.
        stage('Deploy to Dev') {
            when {
                branch 'develop' 
            }
            steps {
                script {
                    // 개발용 compose 파일과 개발용 .env 경로를 사용합니다.
                    sh 'docker compose -f ./docker-compose-dev.yaml --env-file /home/ubuntu/dev/.env up -d --build app'
                }
            }
        }

        // [운영 환경] main 브랜치일 때만 실행됩니다.
        stage('Deploy to Prod') {
            when {
                branch 'main'
            }
            steps {
                script {
                    // 운영용 compose 파일과 운영용 .env 경로를 사용합니다.
                    sh 'docker compose -f ./docker-compose-prod.yaml --env-file /home/ubuntu/prod/.env up -d --build app'
                }
            }
        }
    }
    
    // 빌드 후 찌꺼기 이미지 정리 (디스크 용량 관리)
    post {
        always {
            sh 'docker image prune -f'
        }
    }
}