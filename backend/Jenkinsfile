def checkHealth = { containerName, port ->
    try {
        def hostPort = (containerName == "be-app-dev") ? "8081" : "8080"
        timeout(time: 5, unit: 'MINUTES') {
            waitUntil {
                try {
                    def responseCode = sh(
                        script: "curl -s -o /dev/null -w '%{http_code}' http://172.17.0.1:${hostPort}/api/v1/actuator/health",
                        returnStdout: true
                    ).trim()
                    return responseCode == '200'
                } catch (e) { return false }
            }
        }
        return "SUCCESS"
    } catch (e) { return "FAILURE" }
}

def isManualBuild() {
    return currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause').size() > 0
}

def isDevelopBranch() {
    return env.BRANCH_NAME == 'develop' || 
           env.GIT_BRANCH == 'origin/develop' || 
           sh(script: 'git rev-parse --abbrev-ref HEAD', returnStdout: true).trim() == 'develop'
}

def isMainBranch() {
    return env.BRANCH_NAME == 'main' || 
           env.GIT_BRANCH == 'origin/main' || 
           sh(script: 'git rev-parse --abbrev-ref HEAD', returnStdout: true).trim() == 'main'
}

pipeline {
    agent any 
    tools { jdk 'jdk17' }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'develop',
                    url: 'https://lab.ssafy.com/s14-bigdata-recom-sub1/S14P21E108.git',
                    credentialsId: 'gitlab-auth'
            }
        }

        stage('Spring Boot Build') {
            when {
                anyOf {
                    changeset "backend/**"
                    changeset "docker-compose-dev.yaml"
                    changeset "docker-compose-prod.yaml"
                    expression { return isManualBuild() }
                }
            }
            steps {
                dir('backend') {
                    sh 'chmod +x ./gradlew'
                    script {
                        def jdkPath = tool name: 'jdk17', type: 'jdk'
                        sh "./gradlew clean build -x test -Dorg.gradle.java.home=${jdkPath}"
                    }
                }
            }
        }

        stage('Docker Image Build') {
            when {
                anyOf {
                    changeset "backend/**"
                    changeset "docker-compose-dev.yaml"
                    changeset "docker-compose-prod.yaml"
                    expression { return isManualBuild() }
                }
            }
            steps {
                dir('backend') {
                    script {
                        sh "docker build -t backend-app-${isMainBranch() ? 'prod' : 'dev'} ."
                    }
                }
            }
        }

        stage('Deploy to Dev') {
            when { 
                allOf {
                    anyOf {
                        changeset "backend/**"
                        changeset "docker-compose-dev.yaml"
                        expression { return isManualBuild() }
                    }
                    expression { return isDevelopBranch() }
                }
            } 
            steps {
                withCredentials([file(credentialsId: 'be-dev-env', variable: 'TEMP_ENV')]) {
                    sh "docker rm -f be-app-dev || true"
                    sh "docker compose -p dev -f ./docker-compose-dev.yaml --env-file ${TEMP_ENV} up -d --build --no-deps app"
                    sh "docker network connect ssafy-network be-app-dev || true"
                    script {
                        env.SERVER_STATUS = checkHealth("be-app-dev", "8080")
                        if (env.SERVER_STATUS != "SUCCESS") {
                            error("Dev deployment health check failed")
                        }
                    }
                }
            }
        }

        stage('Deploy to Prod') {
            when { 
                allOf {
                    anyOf {
                        changeset "backend/**"
                        changeset "docker-compose-prod.yaml"
                        expression { return isManualBuild() }
                    }
                    expression { return isMainBranch() }
                }
            }
            steps {
                withCredentials([file(credentialsId: 'be-prod-env', variable: 'TEMP_ENV')]) {
                    sh "docker rm -f be-app-prod || true"
                    sh "docker compose -p prod -f ./docker-compose-prod.yaml --env-file ${TEMP_ENV} up -d --build --no-deps app"
                    sh "docker network connect ssafy-network be-app-prod || true"
                    script {
                        env.SERVER_STATUS = checkHealth("be-app-prod", "8080")
                        if (env.SERVER_STATUS != "SUCCESS") {
                            error("Prod deployment health check failed")
                        }
                    }
                }
            }
        }
    }
}
