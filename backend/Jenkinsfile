pipeline {
    agent any

    tools {
        jdk 'jdk17'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Spring Boot Build') {
            steps {
                dir('backend') {
                    sh 'chmod +x ./gradlew'
                    sh './gradlew clean build -x test'
                }
            }
        }

        stage('Docker Image Build') {
            steps {
                dir('backend') {
                    // 이미지만 빌드합니다. 태그명은 docker-compose와 맞춥니다.
                    sh 'docker build -t backend-app .'
                }
            }
        }

        stage('Deploy with Docker Compose') {
            steps {
                script {
                    // backend 폴더에서 한 단계 위(루트)로 이동하여 실행
                    // --build 옵션은 이미지가 갱신되었을 때만 컨테이너를 재생성합니다.
                    // 'app'을 명시하여 DB 컨테이너는 건드리지 않고 백엔드만 교체합니다.
                    sh 'docker compose -f ./docker-compose.yml up -d --build app'
                }
            }
        }
    }
}