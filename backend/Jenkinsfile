pipeline {
    agent none 
    tools { jdk 'jdk17' }

    stages {
        stage('Spring Boot Build') {
            agent any 
            steps {
                dir('backend') {
                    sh 'chmod +x ./gradlew'
                    script {
                        // 젠킨스 설정에 등록된 jdk17의 실제 경로를 가져와 그래들에 주입합니다.
                        def jdkPath = tool name: 'jdk17', type: 'jdk'
                        sh "./gradlew clean build -x test -Dorg.gradle.java.home=${jdkPath}"
                    }
                }
            }
        }

        stage('Docker Image Build') {
            agent any
            steps {
                dir('backend') {
                    script {
                        def isMain = (env.BRANCH_NAME == 'main' || env.GIT_BRANCH == 'origin/main')
                        sh "docker build -t backend-app-${isMain ? 'prod' : 'dev'} ." [cite: 3, 4]
                    }
                }
            }
        }

        stage('Deploy to Dev') {
            when { branch 'develop' } 
            agent any
            steps {
                withCredentials([file(credentialsId: 'be-dev-env', variable: 'TEMP_ENV')]) {
                    sh "docker compose -f ./docker-compose-dev.yaml --env-file ${TEMP_ENV} up -d --build app" [cite: 5]
                    script { env.SERVER_STATUS = checkHealth("8080") } 
                }
            }
        }

        stage('Deploy to Prod') {
            when { branch 'main' }
            agent any
            steps {
                withCredentials([file(credentialsId: 'be-prod-env', variable: 'TEMP_ENV')]) {
                    sh "docker compose -f ./docker-compose-prod.yaml --env-file ${TEMP_ENV} up -d --build app" [cite: 6]
                    script { env.SERVER_STATUS = checkHealth("8080") } [cite: 7]
                }
            }
        }
    }
}

// 서버 구동 여부를 확인하는 공통 함수
def checkHealth(port) {
    try {
        timeout(time: 3, unit: 'MINUTES') {
            waitUntil {
                try {
                    def response = sh(script: "curl -s http://localhost:${port}/actuator/health", returnStdout: true).trim() [cite: 8]
                    return response.contains('UP')
                } catch (e) { return false }
            }
        }
        return "SUCCESS"
    } catch (e) { return "FAILURE" } [cite: 9]
}