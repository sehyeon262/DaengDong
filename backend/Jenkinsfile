pipeline {
    agent any


    tools {
        // 위 1단계에서 설정한 Name과 정확히 일치해야 합니다.
        jdk 'jdk17'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Spring Boot Build') {
            steps {
                // backend 폴더로 이동해서 gradlew를 실행합니다.
                dir('backend') {
                    sh 'chmod +x ./gradlew'
                    sh './gradlew clean build -x test'
                }
            }
        }

        stage('Docker Build & Run') {
            steps {
                // Docker 작업도 backend 폴더 안의 Dockerfile을 기준으로 수행합니다.
                dir('backend') {
                    script {
                        sh 'docker stop backend-dev || true'
                        sh 'docker rm backend-dev || true'
                        sh 'docker build -t backend-dev .'
                        sh 'docker run -d --name backend-dev -p 8080:8080 backend-dev'
                    }
                }
            }
        }
    }
}