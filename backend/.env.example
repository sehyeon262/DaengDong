# ============================================================
# 환경 변수 설정 파일
# 이 파일을 복사하여 .env로 만들고 실제 값을 채워주세요
# cp .env.example .env
# ============================================================

DB_PASSWORD=your-db-password-here
JWT_SECRET=your-jwt-secret-key-here

# TMAP 도보 길찾기 API
TMAP_APP_KEY=your-tmap-app-key-here
TMAP_ENABLED=true
